PORT=3000
NODE_ENV=development

# Leave DATABASE_PATH unset to use data/pricematch.sqlite.
# Use a persistent disk for the database when deploying the server.
# DATABASE_PATH=C:\path\to\persistent-data\pricematch.sqlite

# Get an API key from SerpApi. Saved alerts use live Google Shopping results.
SERPAPI_KEY=

# Configure an SMTP mailbox to send verification codes and price-drop emails.
# Brevo: use smtp-relay.brevo.com on port 587 with SMTP_SECURE=false.
# SMTP_USER is the Brevo SMTP login; SMTP_PASS is an SMTP key, not an API key.
# SMTP_FROM must be a sender address verified in Brevo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Set this to the public HTTPS site URL before deploying.
PUBLIC_BASE_URL=http://localhost:3000

# In production, use a random secret and keep it private and stable between restarts.
# Without SESSION_SECRET, a random secret is saved in the SQLite database.
# SESSION_SECRET=

# Set to the number of trusted reverse proxies in front of this app, if any.
TRUST_PROXY=0
